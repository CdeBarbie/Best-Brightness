<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FinalBestBrightnessStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FinalBestBrightnessStore.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/lib/bootstrap/imgs/WhatsApp Image 2024-07-02 at 06.18.28_075aad19.jpg" style="height: 70px;width:90px;" />
                    Best Brightness
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <form class="form-inline my-2 my-lg-0">
                    <li class="btn btn-outline-danger my-2 my-sm-0" id="about" type="button">About</li>
                   <li class="btn btn-outline-danger my-2 my-sm-0" id="service" type="button">Our Service</li>
                    <li class="btn btn-outline-danger my-2 my-sm-0"  type="button" onclick="location.href='@Url.Action("Index", "Login")'">Sign In</li>
                </form>
                
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<script>
    const btnAbout = document.getElementById("about");
    const btnService = document.getElementById("service");

    btnAbout.addEventListener("click", function () {
        const aboutSection = document.querySelector("h2:first-of-type");
        aboutSection.scrollIntoView({ behavior: "smooth" });
    });

    btnService.addEventListener("click", function () {
        const serviceSection = document.querySelector("h3:first-of-type");
        serviceSection.scrollIntoView({ behavior: "smooth" });
    });
</script>