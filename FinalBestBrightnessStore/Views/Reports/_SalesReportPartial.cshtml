@{
}
@model IEnumerable<dynamic>

<table class="table mt-3">
    <thead>
        <tr>
            <th>Salesperson ID</th>
            <th>Date</th>
            <th>Total Amount</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model.Orders)
        {
            <tr>
                <td>@order.SalePersonId</td>
                <td>@order.SalesPersonName</td>
                <td>@order.NumberOfProductsSold</td>
                <td>@order.DateOfOrder.ToString("dd-MM-yyyy")</td>
                <td>@order.TotalAmountMade.ToString("F2")</td>
                <td>
                    <a asp-action="ViewSaleSlip" asp-route-id="@order.Id" class="btn btn-info">View Items</a>
                </td>
            </tr>
        }
</table>

<script>
    $(document).ready(function () {
        $('.viewItemsBtn').click(function () {
            var orderId = $(this).data('order-id');
            $.ajax({
                url: '/Admin/GetSaleSlip',
                type: 'GET',
                data: { id: orderId },
                success: function (data) {
                    // Handle the display of sale slip
                    // For simplicity, you could use a modal to show the sale slip
                    $('#saleSlipModalBody').html(data);
                    $('#saleSlipModal').modal('show');
                }
            });
        });
    });
</script>
