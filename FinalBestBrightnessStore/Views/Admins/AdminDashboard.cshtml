@model FinalBestBrightnessStore.Models.AdminDashboard

@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3"></div>
            <div class="col-md-8">
                <div class="row">
                    <div class="col-8">
                        
                    </div><br />
                </div>
            </div>
            <div class="col-md-1"></div>
        </div>

        <div class="row">
            <div class="col-1"></div>
            <div class="col-10">
                <div class="row">
                    <div class="col-md-3 rounded shadow bg-custom text-white">
                        <div class="row">
                            <div class="col-md-10">
                                <h3>Products</h3>
                                <h1>@Model.ProductCount</h1>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-1"></div>
                    <div class="col-md-3 rounded shadow bg-custom text-white">
                        <div class="row">
                            <div class="col-md-10">
                                <h3>Categories</h3>
                                <h1>@Model.CategoryCount</h1>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-1"></div>
                    <div class="col-md-3 rounded shadow bg-custom text-white">
                        <div class="row">
                            <div class="col-md-10">
                                <h3>Products in Category</h3>
                                <form asp-action="AdminDashboard" method="post">
                                    <select asp-for="SelectedCategory" asp-items="@(new SelectList(Model.Categories))" class="form-control" onchange="this.form.submit()">
                                        <option value="">Select a category</option>
                                    </select>
                                </form>
                                <h1>@Model.ProductsInCategoryCount</h1>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-1"></div>
                </div>
            </div>
            <div class="col-1"></div>
        </div>

        <div class="row mb-5 mt-5"></div>

        <div class="row">
            <div class="col-1 bg-gradient"></div>
            <div class="col-10">
                <div class="row">
                    <div class="col-md-3 rounded shadow bg-custom text-white">
                        <div class="row">
                            <div class="col-md-10">
                                <h3>Finance</h3>
                                <h1>@Model.TotalIncome.ToString("F2")</h1>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-1"></div>
                    <div class="col-md-3 rounded shadow bg-custom text-white">
                        <div class="row">
                            <div class="col-md-10">
                                <h3>Sales persons</h3>
                                <h1>@Model.SalesPersonCount</h1>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-1"></div>
                    <div class="col-md-3 rounded shadow bg-custom text-white">
                        <div class="row">
                            <div class="col-md-10">
                                <h3>Stock managers</h3>
                                <h1>@Model.StockManagerCount</h1>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-1"></div>
                </div>
            </div>
            <div class="col-1"></div>
        </div>
    </div>
</body>

<style>
    .bg-custom {
        background-color: #9d4edd;
        color: #fff; /* Ensures text color is white for better readability */
    }
</style>